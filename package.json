{
  "name": "@opengraphninja/sdk",
  "version": "0.2.0",
  "description": "Turn stand-alone links into good-looking previews",
  "license": "MIT",
  "author": "Kristofer Giltvedt Selbekk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opengraphninja/sdk.git"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "sideEffects": false,
  "main": "./dist/opengraphninja.js",
  "module": "./dist/opengraphninja.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/opengraphninja.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/opengraphninja.mjs",
      "require": "./dist/opengraphninja.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "size-limit": "^13.0.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "path": "dist/opengraphninja.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/opengraphninja.mjs",
      "limit": "10 KB"
    },
    {
      "path": "dist/opengraphninja.min.js",
      "limit": "10 KB"
    }
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
